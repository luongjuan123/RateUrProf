rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: universities
// Document ID: {universityId}
// Fields:
//   - id: string (optional, matches universityId)
//   - name: string (required, 1-200 chars)
//   - shortName: string (required, 1-50 chars)
//   - city: string (required, 1-100 chars)
//   - region: string (optional, <= 50 chars)
//   - englishName: string (optional, <= 200 chars)
//   - officialDomain: string (optional, <= 100 chars)
//   - officialWebsite: string (optional, <= 500 chars)
//   - description: string (optional, <= 3000 chars)
//   - logoUrl: string (optional, <= 1000 chars)
//   - coverImage: string (optional, <= 1000 chars)
//   - faculties: list (optional, <= 100 items)
//   - ratingAverage: number (optional, 0-5)
//   - totalReviews: int (optional, >= 0)
//   - totalProfessors: int (optional, >= 0)
//
// Collection: faculties
// Document ID: {facultyId}
// Fields:
//   - id: string (optional, matches facultyId)
//   - universityId: string (required, 1-100 chars)
//   - name: string (required, 1-200 chars)
//   - nameEn: string (optional, <= 200 chars)
//   - websiteUrl: string (optional, <= 500 chars)
//   - deanName: string (optional, <= 150 chars)
//   - departments: list (optional, <= 50 items)
//
// Collection: departments
// Document ID: {departmentId}
// Fields:
//   - id: string (optional, matches departmentId)
//   - facultyId: string (required, 1-100 chars)
//   - universityId: string (required, 1-100 chars)
//   - name: string (required, 1-200 chars)
//   - nameEn: string (optional, <= 200 chars)
//   - headName: string (optional, <= 150 chars)
//
// Collection: professors
// Document ID: {professorId}
// Fields:
//   - id: string (optional, matches professorId)
//   - name: string (required, 1-150 chars)
//   - universityId: string (required, 1-100 chars)
//   - title: string (optional, <= 100 chars)
//   - academicTitle: string (optional, <= 50 chars)
//   - position: string (optional, <= 100 chars)
//   - universityName: string (optional, <= 150 chars)
//   - universityShortName: string (optional, <= 50 chars)
//   - faculty: string (optional, <= 150 chars)
//   - department: string (optional, <= 150 chars)
//   - avatar: string (optional, <= 1000 chars)
//   - bio: string (optional, <= 5000 chars)
//   - courses: list (optional, <= 50 items)
//   - researchInterests: list (optional, <= 50 items)
//   - officialProfileUrls: list (optional, <= 20 items)
//   - identifiers: map (optional)
//   - imageRights: map (optional)
//   - provenance: list (optional, <= 50 items)
//   - verificationStatus: string (optional, 'verified' | 'unverified' | 'pending_review' | 'social_lead_unverified')
//   - confidenceScore: number (optional, 0-1)
//   - ratingAverage: number (optional, 0-5)
//   - ratingCount: int (optional, >= 0)
//   - ratingDistribution: map (optional)
//   - criteriaAverages: map (optional)
//   - featured: bool (optional)
//   - trending: bool (optional)
//   - featuredQuote: string (optional, <= 500 chars)
//   - takeAgainPercent: number (optional, 0-100)
//   - difficultyScore: number (optional, 0-5)
//   - updatedAt: timestamp | int (optional)
//
// Collection: courses
// Document ID: {courseId}
// Fields:
//   - id: string (optional, matches courseId)
//   - universityId: string (required, 1-100 chars)
//   - name: string (required, 1-200 chars)
//   - code: string (optional, <= 50 chars)
//   - description: string (optional, <= 3000 chars)
//
// Collection: professorCourses
// Document ID: {id}
// Fields:
//   - professorId: string (required)
//   - courseId: string (required)
//   - universityId: string (required)
//
// Collection: academicPublications
// Document ID: {pubId}
// Fields:
//   - id: string (optional, matches pubId)
//   - professorId: string (required, 1-100 chars)
//   - title: string (required, 1-500 chars)
//   - authors: list (optional, <= 50 items)
//   - year: int (optional)
//   - venue: string (optional, <= 300 chars)
//   - doi: string (optional, <= 200 chars)
//
// Collection: imageAssets
// Document ID: {assetId}
// Fields:
//   - id: string (optional, matches assetId)
//   - sourceUrl: string (required, 1-1000 chars)
//   - professorId: string (optional, <= 100 chars)
//   - licenseCategory: string (required)
//   - permissionStatus: string (required)
//   - storageMode: string (required)
//
// Collection: sourceDocuments
// Document ID: {docId}
// Fields:
//   - id: string (optional, matches docId)
//   - entityType: string (required, 1-50 chars)
//   - entityId: string (required, 1-100 chars)
//   - title: string (required, 1-200 chars)
//   - content: string (required, 1-10000 chars)
//   - sourceUrl: string (required, 1-1000 chars)
//
// Collection: dataQualityReports
// Document ID: {reportId}
// Fields:
//   - id: string (optional, matches reportId)
//   - generatedAt: int | timestamp (required)
//   - totalUniversities: int (required)
//   - totalProfessors: int (required)
//   - verifiedProfessorsCount: int (required)
//
// Collection: reviews
// Document ID: {reviewId}
//
// Collection: reports
// Document ID: {reportId}
//
// Collection: users
// Document ID: {userId}
//
// Internal Pipeline Collections:
//   - sourceRegistry/{sourceId}
//   - ingestionJobs/{jobId}
//   - ingestionRuns/{runId}
//   - entityMatchCandidates/{candidateId}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'admin') ||
          ('email' in request.auth.token && request.auth.token.email in ['admin@rateprofcuaban.vn', 'admin@rateprofcuaban.com'])
        );
    }

    function isNumber(val) {
      return val is int || val is float;
    }

    function isValidRating(val) {
      return isNumber(val) && val >= 1 && val <= 5;
    }

    function isValidScore(val) {
      return isNumber(val) && val >= 0 && val <= 5;
    }

    function isValidPercent(val) {
      return isNumber(val) && val >= 0 && val <= 100;
    }

    function isTimestampOrEpoch(val) {
      return val is timestamp || val is int || val is float;
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isValidCriteriaRatings(data) {
      return data is map &&
        ('teachingQuality' in data) && isValidRating(data.teachingQuality) &&
        ('clarity' in data) && isValidRating(data.clarity) &&
        ('gradingFairness' in data) && isValidRating(data.gradingFairness) &&
        ('difficulty' in data) && isValidRating(data.difficulty) &&
        ('communication' in data) && isValidRating(data.communication);
    }

    function isValidCriteriaAverages(data) {
      return data is map &&
        (!('teachingQuality' in data) || isValidScore(data.teachingQuality)) &&
        (!('clarity' in data) || isValidScore(data.clarity)) &&
        (!('gradingFairness' in data) || isValidScore(data.gradingFairness)) &&
        (!('difficulty' in data) || isValidScore(data.difficulty)) &&
        (!('communication' in data) || isValidScore(data.communication));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUniversity(data, universityId) {
      return (!('id' in data) || data.id == universityId) &&
        isNonEmptyString(data.name, 1, 200) &&
        isNonEmptyString(data.shortName, 1, 50) &&
        isNonEmptyString(data.city, 1, 100) &&
        isValidOptionalString(data, 'region', 0, 50) &&
        isValidOptionalString(data, 'englishName', 0, 200) &&
        isValidOptionalString(data, 'officialDomain', 0, 100) &&
        isValidOptionalString(data, 'officialWebsite', 0, 500) &&
        isValidOptionalString(data, 'description', 0, 3000) &&
        isValidOptionalString(data, 'logoUrl', 0, 1000) &&
        isValidOptionalString(data, 'coverImage', 0, 1000) &&
        (!('faculties' in data) || (data.faculties is list && data.faculties.size() <= 100)) &&
        (!('ratingAverage' in data) || isValidScore(data.ratingAverage)) &&
        (!('totalReviews' in data) || (data.totalReviews is int && data.totalReviews >= 0)) &&
        (!('totalProfessors' in data) || (data.totalProfessors is int && data.totalProfessors >= 0));
    }

    function isValidProfessor(data, professorId) {
      return (!('id' in data) || data.id == professorId) &&
        isNonEmptyString(data.name, 1, 150) &&
        isNonEmptyString(data.universityId, 1, 100) &&
        isValidOptionalString(data, 'title', 0, 100) &&
        isValidOptionalString(data, 'academicTitle', 0, 50) &&
        isValidOptionalString(data, 'position', 0, 100) &&
        isValidOptionalString(data, 'universityName', 0, 150) &&
        isValidOptionalString(data, 'universityShortName', 0, 50) &&
        isValidOptionalString(data, 'faculty', 0, 150) &&
        isValidOptionalString(data, 'department', 0, 150) &&
        isValidOptionalString(data, 'avatar', 0, 1000) &&
        isValidOptionalString(data, 'bio', 0, 5000) &&
        (!('courses' in data) || (data.courses is list && data.courses.size() <= 50)) &&
        (!('researchInterests' in data) || (data.researchInterests is list && data.researchInterests.size() <= 50)) &&
        (!('officialProfileUrls' in data) || (data.officialProfileUrls is list && data.officialProfileUrls.size() <= 20)) &&
        (!('identifiers' in data) || data.identifiers is map) &&
        (!('confidenceScore' in data) || (isNumber(data.confidenceScore) && data.confidenceScore >= 0 && data.confidenceScore <= 1)) &&
        (!('ratingAverage' in data) || isValidScore(data.ratingAverage)) &&
        (!('ratingCount' in data) || (data.ratingCount is int && data.ratingCount >= 0)) &&
        (!('ratingDistribution' in data) || data.ratingDistribution is map) &&
        (!('criteriaAverages' in data) || isValidCriteriaAverages(data.criteriaAverages)) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('trending' in data) || data.trending is bool) &&
        isValidOptionalString(data, 'featuredQuote', 0, 500) &&
        (!('takeAgainPercent' in data) || isValidPercent(data.takeAgainPercent)) &&
        (!('difficultyScore' in data) || isValidScore(data.difficultyScore));
    }

    function isProfessorRatingUpdate(targetData, currentData) {
      return isAuthenticated() &&
        targetData.diff(currentData).affectedKeys()
          .hasOnly(['ratingAverage', 'ratingCount', 'ratingDistribution', 'criteriaAverages', 'takeAgainPercent', 'difficultyScore', 'updatedAt']) &&
        (!('ratingAverage' in targetData) || isValidScore(targetData.ratingAverage)) &&
        (!('ratingCount' in targetData) || (targetData.ratingCount is int && targetData.ratingCount >= 0)) &&
        (!('ratingDistribution' in targetData) || targetData.ratingDistribution is map) &&
        (!('criteriaAverages' in targetData) || isValidCriteriaAverages(targetData.criteriaAverages)) &&
        (!('takeAgainPercent' in targetData) || isValidPercent(targetData.takeAgainPercent)) &&
        (!('difficultyScore' in targetData) || isValidScore(targetData.difficultyScore)) &&
        (!('updatedAt' in targetData) || isTimestampOrEpoch(targetData.updatedAt));
    }

    function isValidReview(data, reviewId) {
      return (!('id' in data) || data.id == reviewId) &&
        isNonEmptyString(data.professorId, 1, 100) &&
        isNonEmptyString(data.universityId, 1, 100) &&
        isNonEmptyString(data.userId, 1, 100) &&
        isNonEmptyString(data.courseName, 1, 100) &&
        isNonEmptyString(data.comment, 1, 5000) &&
        isValidRating(data.overallRating) &&
        ('criteria' in data) && isValidCriteriaRatings(data.criteria) &&
        (data.attendanceMandatory is bool) &&
        (data.takeAgain is bool) &&
        isValidOptionalString(data, 'professorName', 0, 150) &&
        isValidOptionalString(data, 'userDisplayName', 0, 100) &&
        isValidOptionalString(data, 'gradeReceived', 0, 20) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (data.status in ['published', 'pending', 'flagged', 'hidden']) &&
        (data.helpfulCount is int && data.helpfulCount >= 0) &&
        (data.helpfulUserIds is list && data.helpfulUserIds.size() <= 10000) &&
        isTimestampOrEpoch(data.createdAt) &&
        (!('updatedAt' in data) || data.updatedAt == null || isTimestampOrEpoch(data.updatedAt));
    }

    function isValidReviewCreate(data, reviewId) {
      return isAuthenticated() &&
        request.auth.uid == data.userId &&
        isValidReview(data, reviewId) &&
        (data.status in ['published', 'pending']) &&
        data.helpfulCount == 0 &&
        data.helpfulUserIds.size() == 0;
    }

    function isAuthorReviewUpdate(targetData, currentData, reviewId) {
      return isAuthenticated() &&
        request.auth.uid == currentData.userId &&
        isValidReview(targetData, reviewId) &&
        targetData.userId == currentData.userId &&
        targetData.professorId == currentData.professorId &&
        targetData.universityId == currentData.universityId &&
        targetData.createdAt == currentData.createdAt &&
        targetData.helpfulCount == currentData.helpfulCount &&
        targetData.helpfulUserIds == currentData.helpfulUserIds &&
        targetData.status in ['published', 'pending', currentData.status];
    }

    function isHelpfulReviewUpdate(targetData, currentData) {
      return isAuthenticated() &&
        targetData.diff(currentData).affectedKeys()
          .hasOnly(['helpfulCount', 'helpfulUserIds', 'updatedAt']) &&
        targetData.helpfulCount is int &&
        targetData.helpfulCount >= 0 &&
        targetData.helpfulUserIds is list &&
        targetData.helpfulUserIds.size() <= 10000 &&
        (!('updatedAt' in targetData) || isTimestampOrEpoch(targetData.updatedAt));
    }

    function isValidReport(data, reportId) {
      return (!('id' in data) || data.id == reportId) &&
        isNonEmptyString(data.reviewId, 1, 100) &&
        isNonEmptyString(data.professorId, 1, 100) &&
        isNonEmptyString(data.reportedByUserId, 1, 100) &&
        isNonEmptyString(data.reason, 1, 200) &&
        isValidOptionalString(data, 'details', 0, 2000) &&
        isValidOptionalString(data, 'professorName', 0, 150) &&
        isValidOptionalString(data, 'reviewCommentSnippet', 0, 1000) &&
        (data.status in ['pending', 'resolved', 'dismissed']) &&
        isTimestampOrEpoch(data.createdAt);
    }

    function isValidReportCreate(data, reportId) {
      return isAuthenticated() &&
        data.reportedByUserId == request.auth.uid &&
        isValidReport(data, reportId) &&
        data.status == 'pending';
    }

    function isValidReportUpdate(targetData, currentData, reportId) {
      return isAuthenticated() &&
        isValidReport(targetData, reportId) &&
        targetData.reportedByUserId == currentData.reportedByUserId &&
        targetData.reviewId == currentData.reviewId &&
        targetData.professorId == currentData.professorId &&
        targetData.createdAt == currentData.createdAt;
    }

    function isValidUserProfile(data, userId) {
      return (!('uid' in data) || data.uid == userId) &&
        isValidOptionalString(data, 'email', 0, 150) &&
        isValidOptionalString(data, 'displayName', 0, 100) &&
        isValidOptionalString(data, 'photoURL', 0, 1000) &&
        (!('isAnonymous' in data) || data.isAnonymous is bool) &&
        isValidOptionalString(data, 'university', 0, 150) &&
        isValidOptionalString(data, 'cohort', 0, 50) &&
        (!('role' in data) || data.role in ['student', 'moderator', 'admin']);
    }

    function isValidUserProfileCreate(data, userId) {
      return (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(data, userId) &&
        (!('role' in data) || data.role == 'student' || isAdmin());
    }

    function isValidUserProfileUpdate(targetData, currentData, userId) {
      return (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(targetData, userId) &&
        (!('uid' in targetData) || targetData.uid == userId) &&
        (!('role' in targetData) || targetData.role == currentData.get('role', 'student') || isAdmin());
    }

    // ===============================================================
    // Rules Definition
    // ===============================================================

    // Universities collection (Public read, admin write)
    match /universities/{universityId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidUniversity(request.resource.data, universityId);
      allow delete: if isAdmin();
    }

    // Faculties collection (Public read, admin write)
    match /faculties/{facultyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Departments collection (Public read, admin write)
    match /departments/{departmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Professors collection (Public read, admin write for academic profile, authenticated rating updates)
    match /professors/{professorId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProfessor(request.resource.data, professorId);
      allow update: if (isAdmin() && isValidProfessor(request.resource.data, professorId)) ||
                      isProfessorRatingUpdate(request.resource.data, resource.data);
      allow delete: if isAdmin();
    }

    // Courses & ProfessorCourses collections (Public read, admin write)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /professorCourses/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Academic Publications (Public read, admin write)
    match /academicPublications/{pubId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Image Assets (Public read, admin write)
    match /imageAssets/{assetId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Source Documents for RAG Citation Retrieval (Public read, admin write)
    match /sourceDocuments/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Data Quality & Coverage Reports (Public read for transparency, admin write)
    match /dataQualityReports/{reportId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reviews collection (Preserving verified student review system)
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' ||
                     (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isValidReviewCreate(request.resource.data, reviewId);
      allow update: if isAuthorReviewUpdate(request.resource.data, resource.data, reviewId) ||
                       isHelpfulReviewUpdate(request.resource.data, resource.data) ||
                       (isAdmin() && isValidReview(request.resource.data, reviewId));
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isValidReportCreate(request.resource.data, reportId);
      allow update: if isValidReportUpdate(request.resource.data, resource.data, reportId) || isAdmin();
      allow delete: if isAuthenticated() && (resource.data.reportedByUserId == request.auth.uid || isAdmin());
    }

    // Users collection (PII Protected)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isValidUserProfileCreate(request.resource.data, userId);
      allow update: if isValidUserProfileUpdate(request.resource.data, resource.data, userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Sensitive internal pipeline collections (Admin only read/write)
    match /sourceRegistry/{sourceId} {
      allow read, write: if isAdmin();
    }

    match /ingestionJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /ingestionRuns/{runId} {
      allow read, write: if isAdmin();
    }

    match /entityMatchCandidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
